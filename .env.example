# ============================================================
# GitDaily — Environment Variables Example
# Copy this file to .env.local (local dev) or .env (production)
# and fill in the actual values. Never commit real secrets.
# ============================================================

# ------------------------------------------------------------
# Database (MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# ------------------------------------------------------------
DATABASE_URL="mysql://root:password@localhost:3306/git_daily"

# ------------------------------------------------------------
# Redis
# Local dev:  redis://localhost:6379
# Docker Compose (production): redis://redis:6379
# ------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------
# NextAuth
# NEXTAUTH_URL: the full public URL of your app (no trailing slash)
# NEXTAUTH_SECRET: random secret for signing JWT sessions
#   Generate with: openssl rand -base64 32
# ------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ------------------------------------------------------------
# Encryption key for storing GitLab Personal Access Tokens at rest
# Must be exactly 64 hex characters (32 bytes)
# Generate with: openssl rand -hex 32
# WARNING: if you change this after users have saved tokens,
#          they will need to re-enter their GitLab token.
# ------------------------------------------------------------
ENCRYPTION_KEY=""

# ------------------------------------------------------------
# GitLab OAuth (SSO)
# Register an OAuth Application in GitLab (User Settings → Applications):
#   Redirect URI: {NEXTAUTH_URL}/api/auth/callback/gitlab
#   Scopes: read_user + api
# ------------------------------------------------------------
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
# Optional: self-hosted GitLab issuer URL (defaults to https://gitlab.com)
# GITLAB_OAUTH_ISSUER="https://gitlab.example.com"

# ------------------------------------------------------------
# AI report polish (optional, OpenAI-compatible endpoint)
# Leave LLM_API_KEY empty to disable this feature.
# ------------------------------------------------------------
LLM_API_BASE="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# ------------------------------------------------------------
# Initial admin account (used by the seed script on first run)
# Change the password after your first login.
# ------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin12345"
ADMIN_DISPLAY_NAME="Admin"
