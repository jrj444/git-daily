// Prisma schema for pingyun-report
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  passwordHash  String
  displayName   String
  role          Role      @default(MEMBER)
  gitlabBaseUrl String?
  gitlabToken   String?   @db.Text // AES-256-GCM encrypted, base64
  gitlabUserId  Int?
  gitlabEmail   String?
  noiseRegex    String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects      Project[]
  reports       Report[]
  templates     Template[]
  comments      Comment[]      @relation("CommentAuthor")
  likes         Like[]         @relation("LikeUser")
  notifications Notification[] @relation("NotificationUser")
}

model Project {
  id                String   @id @default(cuid())
  userId            String
  gitlabProjectId   Int
  nameWithNamespace String
  alias             String?
  webUrl            String?
  defaultBranch     String?
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gitlabProjectId])
  @@index([userId])
}

model Report {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @db.Date
  content    String   @db.LongText
  rawCommits Json?
  templateId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments   Comment[]
  likes      Like[]

  @@unique([userId, date])
  @@index([userId, date])
}

model Template {
  id        String   @id @default(cuid())
  userId    String
  name      String
  body      String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  reportId  String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author    User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model Like {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  createdAt DateTime @default(now())

  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User     @relation("LikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  relatedId String?
  createdAt DateTime @default(now())

  user      User     @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}
